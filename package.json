{
    "private": true,
    "scripts": {
        "dev": "npm-run-all --parallel watch-css vite",
        "build": "vite build",
        "mix-dev": "npm run development",
        "development": "mix",
        "dev:css": "tailwindcss -i ./resources/css/app.css -o ./public/build/assets/output.css --watch",
        "watch": "mix watch",
        "build-css": "node public/js/build-css.js",
        "watch-css": "node public/js/build-css.js --watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@vitejs/plugin-vue": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.21",
        "axios": "^1.20.0",
        "laravel-mix": "^6.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "lodash": "^4.17.19",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.6",
        "tailwind-scrollbar": "^3.0.0",
        "tailwindcss": "^3.4.17",
        "vite": "^8.3.0"
    },
    "dependencies": {
        "animate.css": "^4.1.1",
        "aos": "^2.3.4",
        "lucide": "^0.525.0",
        "swiper": "^14.2.0",
        "vue-multiselect": "^3.2.0"
    },
    "allowScripts": {
        "esbuild@0.18.20": true
    }
}
