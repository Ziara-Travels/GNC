APP_NAME="Ziara Travels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flightapp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@ziaratravels.co.ke
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# RapidAPI - flights-sky (https://rapidapi.com/ntd119/api/flights-sky)
RAPIDAPI_KEY=
RAPIDAPI_HOST_FLIGHTS=flights-sky.p.rapidapi.com
RAPIDAPI_HOST_HOTELS=hotels-com6.p.rapidapi.com
RAPIDAPI_HOST_BOOKING=booking-com18.p.rapidapi.com
RAPIDAPI_MOCK=false

# Sky Scanner (flights) defaults
SKYSCANNER_MARKET=KE
SKYSCANNER_LOCALE=en-KE
SKYSCANNER_CURRENCY=KES
SKYSCANNER_MOCK=false
SKYSCANNER_TIMEOUT=30

# Hotels COM (hotels-com6) defaults
HOTELS_LOCALE=en_US
HOTELS_CURRENCY=KES
HOTELS_MOCK=false
HOTELS_TIMEOUT=35

# Booking COM (booking-com18) defaults
BOOKING_LOCALE=en-gb
BOOKING_CURRENCY=KES
BOOKING_MOCK=false
BOOKING_TIMEOUT=35

# Jenga (Finserve / Equity) - M-Pesa STK, Equity, bank-to-bank, card
JENGA_BASE_URL=https://api.finserve.africa/v3-apis/account-api/v3.0/
JENGA_MERCHANT_CODE=
JENGA_API_KEY=
Consumer_Secret=
JENGA_CALLBACK_URL=https://your-domain.com/api/payments/jenga/callback

# Booking.com affiliate (hotel deeplinks)
BOOKINGCOM_AFFILIATE_ID=
BOOKINGCOM_DEEPLINK=https://www.booking.com
BOOKINGCOM_CURRENCY=KES
